# Copy to `.env` and fill in what you have. Everything is optional:
# with no keys the app runs fully offline in deterministic "stub" mode.

# --- LLM (leave blank to use the offline stub provider) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=2048

# --- Web search (Tavily preferred; falls back to DuckDuckGo, then stub) ---
TAVILY_API_KEY=
SEARCH_RESULTS_PER_QUERY=4

# --- Workflow tuning ---
QUALITY_THRESHOLD=0.7
MAX_RESEARCH_RETRIES=1

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_PATH=copilot.db
CHECKPOINT_PATH=checkpoints.db
